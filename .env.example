# ==============================================================================
# DENNO CAREER OS — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and fill in your local development values
# ==============================================================================

# ── Application Metadata ──────────────────────────────────────────────────────
APP_NAME="Denno Career OS"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database (PostgreSQL + asyncpg) ──────────────────────────────────────────
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/denno
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache & Background Queue (Redis) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication & Security ────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 32
# NEVER commit the real value — .env is in .gitignore for this reason.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated trusted hostnames for TrustedHostMiddleware.
# In production set to your actual domain, e.g. api.denno.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true in production (requires HTTPS). Controls httpOnly refresh-token cookie.
COOKIE_SECURE=false

# ── Bot Protection (Cloudflare Turnstile) ─────────────────────────────────────
# Obtain keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Set TURNSTILE_SECRET_KEY to enable CAPTCHA verification on /register and /login.
# Leave blank in local development to skip the check entirely.
TURNSTILE_SECRET_KEY=

# ── Brute-Force Login Protection ─────────────────────────────────────────────
# Hard-lock an IP+email pair after this many consecutive failures (Redis-backed).
BRUTE_FORCE_MAX_ATTEMPTS=10
# Duration of the hard lockout in minutes.
BRUTE_FORCE_LOCKOUT_MINUTES=15

# ── Bot Shield Middleware ─────────────────────────────────────────────────────
# Set to false ONLY in automated test environments to skip UA-based bot blocking.
BOT_SHIELD_ENABLED=true

# ── AI & LLM Providers ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=claude-3-5-sonnet-20241022

# ── Email / SMTP Service ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Use a Gmail App Password (not your account password).
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

SMTP_FROM_EMAIL=noreply@denno.app
SMTP_FROM_NAME="Denno Career OS"
EMAILS_ENABLED=true

# ── CORS & Frontend Integration ──────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# ── Storage & Document Uploads ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Third-Party OAuth & Integrations ─────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
