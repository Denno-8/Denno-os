# ==============================================================================
# DENNO CAREER OS — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and fill in your local development values
# ==============================================================================

# ── Application Metadata ──────────────────────────────────────────────────────
APP_NAME="Denno Career OS"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database (PostgreSQL + asyncpg) ──────────────────────────────────────────
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/denno
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Cache & Background Queue (Redis) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication & Security ────────────────────────────────────────────────
# Production Deployment Checklist:
# 1. Generate strong secret: openssl rand -hex 32
# 2. Set APP_ENV=production and DEBUG=false
# 3. Set ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
# 4. Set FRONTEND_ORIGIN=https://your-frontend.vercel.app
# 5. Set COOKIE_SECURE=true (requires HTTPS)
# 6. Set DATABASE_URL=postgresql+asyncpg://user:pass@production-host:5432/denno
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false

# ── Bot Protection (Cloudflare Turnstile) ─────────────────────────────────────
# Obtain keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Set TURNSTILE_SECRET_KEY to enable CAPTCHA verification on /register and /login.
# Leave blank in local development to skip the check entirely.
TURNSTILE_SECRET_KEY=

# ── Brute-Force Login Protection ─────────────────────────────────────────────
# Hard-lock an IP+email pair after this many consecutive failures (Redis-backed).
BRUTE_FORCE_MAX_ATTEMPTS=10
# Duration of the hard lockout in minutes.
BRUTE_FORCE_LOCKOUT_MINUTES=15

# ── Bot Shield Middleware ─────────────────────────────────────────────────────
# Set to false ONLY in automated test environments to skip UA-based bot blocking.
BOT_SHIELD_ENABLED=true

# ── AI & LLM Providers ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=claude-3-5-sonnet-20241022

# ── Email / SMTP Service ──────────────────────────────────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
# Port 587 + STARTTLS (recommended for Gmail): SMTP_PORT=587, SMTP_TLS=true, SMTP_USE_SSL=false
# Port 465 + SSL:                              SMTP_PORT=465, SMTP_TLS=false, SMTP_USE_SSL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@denno.app
SMTP_FROM_NAME="Denno Career OS"
SMTP_TLS=true
SMTP_USE_SSL=false
# Set to true to actually send emails. Leave false in local dev to log instead.
EMAILS_ENABLED=false

# ── CORS & Frontend Integration ──────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# ── Storage & Document Uploads ──────────────────────────────────────────────
# Local disk fallback — used when AWS_ACCESS_KEY_ID is not set.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Cloud Object Storage (S3 / MinIO) ────────────────────────────────────────
# AWS S3:   Leave S3_ENDPOINT_URL blank; set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# MinIO:    Set S3_ENDPOINT_URL=http://localhost:9000; use MinIO root user credentials.
# Disabled: Leave AWS_ACCESS_KEY_ID blank — falls back to local disk (UPLOAD_DIR).
S3_ENDPOINT_URL=
S3_BUCKET_NAME=denno-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Third-Party OAuth ─────────────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gmail API (for future Gmail sync — separate from SMTP above)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Observability (Sentry) ────────────────────────────────────────────────────
# Obtain a free DSN at https://sentry.io
# Leave blank in local development to disable error tracking.
SENTRY_DSN=
# 0.0 = no performance tracing; 1.0 = trace every request (expensive in production)
SENTRY_TRACES_SAMPLE_RATE=0.1
